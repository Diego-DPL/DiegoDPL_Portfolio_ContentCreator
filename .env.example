# Clave de Web3Forms para que el formulario de contacto te llegue por email.
# Sácala gratis en https://web3forms.com poniendo info@diegodpl.com.
# En Vercel se añade en Settings → Environment Variables con este mismo nombre.
PUBLIC_WEB3FORMS_KEY=

# Sólo si verificas Search Console con la etiqueta HTML en vez de por DNS.
# Verificar por DNS es mejor: cubre www, apex, http y https de una vez.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (G-XXXXXXXXXX). Sin ella no se carga Analytics ni sale
# el banner de cookies. Analytics sólo arranca si el visitante acepta.
PUBLIC_GA_ID=
