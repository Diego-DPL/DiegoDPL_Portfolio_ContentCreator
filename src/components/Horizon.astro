---
/**
 * EL HORIZONTE
 * ------------
 * El desierto del hero, dibujado en código: no hay foto que cargar, pesa
 * unos pocos kB y escala a cualquier pantalla sin perder nitidez.
 *
 * Cuatro capas de dunas, de la más lejana (bruma rosada) a la más cercana
 * (del mismo negro que la página, para que el suelo se funda con ella).
 * El sol se pone detrás de la primera cresta y una figura diminuta corre
 * sola por la segunda. Ese tamaño es el mensaje: nadie más en kilómetros.
 *
 * horizon.ts mueve las capas con el ratón y con el scroll, y hace correr
 * a la figura siguiendo la línea exacta de la cresta.
 *
 * `night` es la variante de la 404: el mismo desierto de noche, sin sol ni
 * corredor. Sólo quedan unas huellas que se cortan a mitad de la duna.
 */
interface Props {
  night?: boolean;
}
const { night = false } = Astro.props;

const W = 1600;
const H = 900;

/**
 * Una cresta de duna: suma de senos con fases fijas (el dibujo es siempre
 * el mismo en cada carga). El término al cuadrado afila las cimas y suaviza
 * los valles, que es justo la silueta que tiene la arena.
 */
function ridge(base: number, amp: number, seed: number, freq = 1): Array<[number, number]> {
  const pts: Array<[number, number]> = [];
  for (let x = -120; x <= W + 120; x += 16) {
    const t = (x / W) * Math.PI * 2 * freq;
    const a = Math.sin(t * 1.3 + seed);
    const b = Math.sin(t * 2.7 + seed * 1.7) * 0.45;
    const c = Math.sin(t * 5.1 + seed * 0.6) * 0.12;
    const crest = Math.pow((a + 1) / 2, 1.8) * 2 - 1; // cimas afiladas
    pts.push([x, base - (crest * 0.7 + b + c) * amp]);
  }
  return pts;
}

/** Curva suave que pasa por los puntos medios (sin picos de polilínea) */
function smooth(pts: Array<[number, number]>): string {
  let d = `M${pts[0]![0]},${pts[0]![1].toFixed(1)}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [x, y] = pts[i]!;
    const [nx, ny] = pts[i + 1]!;
    d += ` Q${x},${y.toFixed(1)} ${((x + nx) / 2).toFixed(1)},${((y + ny) / 2).toFixed(1)}`;
  }
  const last = pts[pts.length - 1]!;
  return `${d} L${last[0]},${last[1].toFixed(1)}`;
}

const layers = [
  { id: 'far', base: 648, amp: 16, seed: 0.4, freq: 1.6, fill: night ? '#2B211F' : 'url(#hz-far)' },
  { id: 'mid', base: 690, amp: 30, seed: 2.1, freq: 1.1, fill: night ? '#191213' : 'url(#hz-mid)' },
  { id: 'near', base: 752, amp: 38, seed: 4.3, freq: 0.9, fill: night ? '#100C0B' : '#170E0B' },
  { id: 'ground', base: 836, amp: 46, seed: 1.2, freq: 0.7, fill: '#0B0907' },
].map((l) => {
  const top = smooth(ridge(l.base, l.amp, l.seed, l.freq));
  return { ...l, top, shape: `${top} L${W + 120},${H + 200} L-120,${H + 200} Z` };
});

const [far, mid, near, ground] = layers as [typeof layers[0], typeof layers[0], typeof layers[0], typeof layers[0]];

// Sol: bajo, a la derecha, medio hundido tras la primera cresta
const sun = { x: 1236, y: 628, r: 54 };
const rim = night ? 'url(#hz-rim-night)' : 'url(#hz-rim)';

/* — Sólo de noche — */

// Generador con semilla: el cielo es siempre el mismo
let seedN = 7;
const rand = (): number => ((seedN = (seedN * 16807) % 2147483647) / 2147483647);
const stars = night
  ? Array.from({ length: 110 }, () => ({
      x: rand() * W,
      y: rand() * 560,
      r: 0.4 + rand() * 1.1,
      o: 0.2 + rand() * 0.6,
      twinkle: rand() < 0.18,
    }))
  : [];

// Huellas por la cresta media: empiezan fuera de plano y se acaban de golpe
const midRidge = ridge(690, 30, 2.1, 1.1);
const crestY = (x: number): number => {
  const i = midRidge.findIndex(([px]) => px >= x);
  const [x1, y1] = midRidge[Math.max(0, i - 1)]!;
  const [x2, y2] = midRidge[i]!;
  return y1 + ((y2 - y1) * (x - x1)) / (x2 - x1 || 1);
};
const steps = night
  ? Array.from({ length: 44 }, (_, i) => {
      const x = 520 + i * 11;
      return { x, y: crestY(x) + (i % 2 ? 1.6 : -0.4), o: Math.min(0.75, 0.15 + i * 0.02) };
    })
  : [];
const moon = { x: 1150, y: 250, r: 20 };
---

<div class:list={['hz', night && 'hz--night']} data-horizon aria-hidden="true">
  <svg
    class="hz__svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMax slice"
    data-horizon-svg
  >
    <defs>
      <!-- El cielo: noche arriba, brasa en el horizonte -->
      <linearGradient id="hz-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0B0907" />
        <stop offset="0.34" stop-color="#170E0B" />
        <stop offset="0.52" stop-color="#3A1C15" />
        <stop offset="0.63" stop-color="#7A3622" />
        <stop offset="0.69" stop-color="#C0612F" />
        <stop offset="0.73" stop-color="#E89A55" />
        <stop offset="0.76" stop-color="#F4C685" />
      </linearGradient>

      <!-- El resplandor del sol, ancho y bajo como a última hora -->
      <radialGradient id="hz-glow" cx={sun.x} cy={sun.y} r="760" gradientUnits="userSpaceOnUse"
        gradientTransform={`translate(${sun.x} ${sun.y}) scale(1 0.42) translate(${-sun.x} ${-sun.y})`}>
        <stop offset="0" stop-color="#FFD9A0" stop-opacity="0.85" />
        <stop offset="0.18" stop-color="#F29A52" stop-opacity="0.5" />
        <stop offset="0.5" stop-color="#B8532B" stop-opacity="0.18" />
        <stop offset="1" stop-color="#B8532B" stop-opacity="0" />
      </radialGradient>

      <radialGradient id="hz-halo">
        <stop offset="0.3" stop-color="#FFD08E" stop-opacity="0.32" />
        <stop offset="1" stop-color="#FFD08E" stop-opacity="0" />
      </radialGradient>

      <radialGradient id="hz-sun" cx="0.5" cy="0.45" r="0.55">
        <stop offset="0" stop-color="#FFF1D6" />
        <stop offset="0.55" stop-color="#FFD08E" />
        <stop offset="1" stop-color="#F3A05A" />
      </radialGradient>

      <!-- Dunas lejanas: más claras cuanto más cerca del sol (bruma) -->
      <linearGradient id="hz-far" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#4A2820" />
        <stop offset="0.55" stop-color="#7E4130" />
        <stop offset="0.77" stop-color="#A65A3C" />
        <stop offset="1" stop-color="#6E3829" />
      </linearGradient>
      <linearGradient id="hz-mid" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#22140F" />
        <stop offset="0.7" stop-color="#3E2218" />
        <stop offset="1" stop-color="#2A1811" />
      </linearGradient>

      <!-- Luz rasante sobre las crestas que miran al sol -->
      <linearGradient id="hz-rim" x1="0" y1="0" x2={W} y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#F2A864" stop-opacity="0" />
        <stop offset="0.45" stop-color="#F2A864" stop-opacity="0.08" />
        <stop offset="0.77" stop-color="#FFC98A" stop-opacity="0.75" />
        <stop offset="1" stop-color="#F2A864" stop-opacity="0.1" />
      </linearGradient>

      <!-- Noche: cielo casi negro con un poso cálido en el horizonte -->
      <linearGradient id="hz-sky-night" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#050406" />
        <stop offset="0.5" stop-color="#0C0A0D" />
        <stop offset="0.66" stop-color="#1A1316" />
        <stop offset="0.75" stop-color="#2E201C" />
      </linearGradient>
      <radialGradient id="hz-moon-halo">
        <stop offset="0" stop-color="#EDE6D6" stop-opacity="0.22" />
        <stop offset="1" stop-color="#EDE6D6" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="hz-rim-night" x1="0" y1="0" x2={W} y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#D9D2C4" stop-opacity="0" />
        <stop offset="0.72" stop-color="#D9D2C4" stop-opacity="0.28" />
        <stop offset="1" stop-color="#D9D2C4" stop-opacity="0.05" />
      </linearGradient>

      <!-- Calima: el aire caliente hace temblar el sol -->
      <filter id="hz-haze" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.004 0.16" numOctaves="1" seed="3">
          <animate attributeName="baseFrequency" dur="9s" repeatCount="indefinite"
            values="0.004 0.16;0.005 0.12;0.004 0.16" />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>

    <rect width={W} height={H} fill={night ? 'url(#hz-sky-night)' : 'url(#hz-sky)'} />

    {
      night ? (
        <g data-hz-sun>
          <g fill="#EDE6D6">
            {stars.map((st) => (
              <circle cx={st.x.toFixed(1)} cy={st.y.toFixed(1)} r={st.r.toFixed(2)} opacity={st.o.toFixed(2)}
                class:list={[st.twinkle && 'hz__twinkle']} />
            ))}
          </g>
          <circle cx={moon.x} cy={moon.y} r={moon.r * 5} fill="url(#hz-moon-halo)" opacity="0.6" />
          <!-- cuarto menguante: una máscara recorta la luna, no el halo -->
          <mask id="hz-crescent">
            <circle cx={moon.x} cy={moon.y} r={moon.r} fill="#fff" />
            <circle cx={moon.x + 9} cy={moon.y - 5} r={moon.r * 0.95} fill="#000" />
          </mask>
          <circle cx={moon.x} cy={moon.y} r={moon.r} fill="#EDE6D6" opacity="0.9" mask="url(#hz-crescent)" />
        </g>
      ) : (
        <g data-hz-sun>
          <rect width={W} height={H} fill="url(#hz-glow)" />
          <g filter="url(#hz-haze)">
            <circle cx={sun.x} cy={sun.y} r={sun.r * 2.2} fill="url(#hz-halo)" />
            <circle cx={sun.x} cy={sun.y} r={sun.r} fill="url(#hz-sun)" />
          </g>
        </g>
      )
    }

    <!-- Noche que cae: sólo la mueve el scroll -->
    <rect width={W} height={H} fill="#0B0907" opacity="0" data-hz-dusk />

    <g data-hz-layer="far" data-depth="0.12">
      <path d={far.shape} fill={far.fill} />
    </g>

    <g data-hz-layer="mid" data-depth="0.3">
      <path d={mid.shape} fill={mid.fill} />
      <path d={mid.top} fill="none" stroke={rim} stroke-width="1.4" />

      {
        night && (
          <g fill="#D9D2C4">
            {steps.map((st) => (
              <ellipse cx={st.x} cy={st.y.toFixed(1)} rx="1.8" ry="0.8" opacity={st.o.toFixed(2)} />
            ))}
          </g>
        )
      }

      <!--
        El corredor. Mide 15 unidades de alto en un paisaje de 1600:
        la escala es lo que cuenta la soledad.
      -->
      {!night && <Fragment>
      <path d={mid.top} fill="none" stroke="none" data-hz-path />
      <g data-hz-runner transform="translate(1000 690)">
        <!-- sombra larga hacia la izquierda: el sol está a su derecha -->
        <ellipse cx="-16" cy="0.5" rx="17" ry="0.9" fill="#0B0907" opacity="0.45" />
        <g fill="none" stroke="#0E0907" stroke-linecap="round" stroke-width="1.7">
          <circle cx="1.6" cy="-14.6" r="1.9" fill="#0E0907" stroke="none" />
          <path d="M1.2 -12.4 L0.2 -6.4" />
          <path d="M0.2 -6.4 L-3 0">
            <animateTransform attributeName="transform" type="rotate" dur="0.56s"
              repeatCount="indefinite" values="-26 0.2 -6.4;30 0.2 -6.4;-26 0.2 -6.4" />
          </path>
          <path d="M0.2 -6.4 L3 0">
            <animateTransform attributeName="transform" type="rotate" dur="0.56s"
              repeatCount="indefinite" values="30 0.2 -6.4;-26 0.2 -6.4;30 0.2 -6.4" />
          </path>
          <path d="M1.1 -11.4 L-1.8 -8.2" stroke-width="1.3">
            <animateTransform attributeName="transform" type="rotate" dur="0.56s"
              repeatCount="indefinite" values="34 1.1 -11.4;-30 1.1 -11.4;34 1.1 -11.4" />
          </path>
          <path d="M1.1 -11.4 L3.8 -8.6" stroke-width="1.3">
            <animateTransform attributeName="transform" type="rotate" dur="0.56s"
              repeatCount="indefinite" values="-30 1.1 -11.4;34 1.1 -11.4;-30 1.1 -11.4" />
          </path>
        </g>
        <!-- el polvo que levanta al pisar -->
        <g fill="#E7B98A">
          <circle cx="-4" cy="-1" r="1.4" opacity="0">
            <animate attributeName="cx" dur="1.1s" repeatCount="indefinite" values="-3;-14" />
            <animate attributeName="cy" dur="1.1s" repeatCount="indefinite" values="-1;-5" />
            <animate attributeName="opacity" dur="1.1s" repeatCount="indefinite" values="0.5;0" />
          </circle>
          <circle cx="-4" cy="-1" r="2" opacity="0">
            <animate attributeName="cx" dur="1.6s" begin="0.4s" repeatCount="indefinite" values="-3;-22" />
            <animate attributeName="cy" dur="1.6s" begin="0.4s" repeatCount="indefinite" values="-1;-8" />
            <animate attributeName="opacity" dur="1.6s" begin="0.4s" repeatCount="indefinite" values="0.3;0" />
          </circle>
        </g>
      </g>
      </Fragment>}
    </g>

    <g data-hz-layer="near" data-depth="0.6">
      <path d={near.shape} fill={near.fill} />
      <path d={near.top} fill="none" stroke={rim} stroke-width="1" opacity="0.55" />
    </g>

    <g data-hz-layer="ground" data-depth="1">
      <path d={ground.shape} fill={ground.fill} />
    </g>
  </svg>
</div>

<style>
  .hz {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* entra desde la noche: se revela cuando termina el preloader */
    opacity: 0;
    transition: opacity 2.4s var(--ease-soft);
  }
  :global(body.is-ready) .hz { opacity: 1; }

  .hz__svg {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  /*
    Móvil: el texto ocupa la mitad baja de la pantalla. El paisaje se queda
    arriba y el suelo (del mismo negro que la página) sostiene el texto.
  */
  @media (max-width: 899px) {
    .hz { bottom: auto; height: 68svh; }
  }

  .hz__twinkle { animation: hz-twinkle 3.8s ease-in-out infinite; }
  .hz__twinkle:nth-child(3n) { animation-duration: 5.2s; animation-delay: -2s; }
  .hz__twinkle:nth-child(5n) { animation-duration: 4.4s; animation-delay: -1s; }
  @keyframes hz-twinkle {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hz { opacity: 1; transition: none; }
    .hz__twinkle { animation: none; }
  }
</style>
