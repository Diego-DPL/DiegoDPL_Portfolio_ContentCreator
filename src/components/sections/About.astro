---
import { site, certification } from '~/data/site';
import DustFrame from '~/components/DustFrame.astro';
import casaSierra from '~/assets/media/casa-sierra.jpg';

const ficha = [
  { label: 'Base', value: site.location },
  { label: 'Disciplinas', value: 'Dirección · Foto · Edición' },
  { label: 'Idiomas', value: site.languages.join(' · ') },
  { label: 'Estética', value: 'Documental analógica' },
  { label: 'Certificación', value: certification.claim },
];
---

<section class="about" id="sobre-mi" data-tone="day" data-chapter="Quién corre">
  <div class="shell about__grid">
    <div class="about__media">
      <DustFrame
        src={casaSierra}
        alt="Diego DPL sentado en el umbral de una casa abandonada en la sierra, al atardecer"
        format="tall"
        sizes="(min-width: 950px) 42vw, 100vw"
        position="50% 58%"
        seed={11}
      />
      <p class="about__caption kicker">
        {site.coords} — a la hora en que todavía no hay nadie
      </p>
    </div>

    <div class="about__text">
      <p class="kicker" data-reveal>03 — Sobre mí</p>

      <h2 class="about__title display t-lg" data-reveal style="--rv-delay:.08s">
        No hago contenido<br />sobre correr.<br />
        <em>Hago contenido sobre insistir.</em>
      </h2>

      <div class="about__prose" data-reveal style="--rv-delay:.16s">
        <p>
          Me llamo Diego. Vivo en Murcia, corro casi todos los días y llevo una
          cámara conmigo desde antes de saber para qué. Durante años hice música;
          aprendí ahí lo único que me ha servido después: que nada bueno sale a la
          primera y que el trabajo que nadie ve es el que decide.
        </p>
        <p>
          Ahora ruedo lo que conozco. Carreteras vacías, luz dura de mediodía,
          gente que sigue cuando ya no le apetece. Grabo con la estética con la
          que veo: grano, color cálido, encuadres que respiran. Nada de brillo
          falso — si el sudor está, se ve.
        </p>
        <p>
          Trabajo con marcas que entienden que la confianza de una audiencia no
          se alquila por una publicación. Se construye igual que todo lo demás:
          apareciendo, otra vez, al día siguiente.
        </p>
        <p>
          Y esa confianza también se cuida en la letra pequeña: estoy certificado
          por AUTOCONTROL en normativa publicitaria, así que lo que es publicidad
          se dice que es publicidad.
        </p>
      </div>

      <dl class="about__ficha" data-reveal style="--rv-delay:.24s">
        {
          ficha.map((f) => (
            <div class="about__ficha-row">
              <dt class="kicker">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <a
        class="cert"
        href={certification.file}
        target="_blank"
        rel="noopener"
        data-reveal
        style="--rv-delay:.3s"
      >
        <span class="cert__seal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M12 2.5 14.6 5l3.5-.3.4 3.5L21 10.6l-1.7 3 .6 3.4-3.4.9-2 2.9-3.2-1.4-3.2 1.4-2-2.9-3.4-.9.6-3.4L1.6 10.6 4.5 8.2l.4-3.5L8.4 5 12 2.5Z" stroke-linejoin="round" />
            <path d="m9 12.2 2.1 2.1 4-4.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="cert__text">
          <span class="kicker cert__label">{certification.short}</span>
          <span class="cert__name">{certification.name}</span>
          <span class="kicker cert__meta">
            {certification.issuerFull} · {certification.validLabel}
          </span>
        </span>
        <span class="kicker cert__cta" aria-hidden="true">Ver <span>→</span></span>
        <span class="sr-only">Abrir el certificado en PDF</span>
      </a>
    </div>
  </div>
</section>

<style>
  .about { padding-block: clamp(6rem, 13vw, 13rem); }

  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 950px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
      gap: clamp(3rem, 6vw, 7rem);
    }
    .about__media { position: sticky; top: 12vh; }
  }

  .about__caption { margin: 1rem 0 0; color: var(--fg-faint); }

  .about__text { display: grid; gap: 1.75rem; align-content: start; }

  .about__title { margin: 0; }
  .about__title em { font-style: italic; color: var(--accent); }

  .about__prose { display: grid; gap: 1.15rem; max-width: 56ch; }
  .about__prose p {
    margin: 0;
    font-size: clamp(1rem, 0.94rem + 0.28vw, 1.125rem);
    line-height: 1.68;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .about__ficha {
    margin: 1rem 0 0;
    display: grid;
    gap: 0;
    max-width: 34rem;
  }
  .about__ficha-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
  }
  .about__ficha-row dd { margin: 0; font-size: 0.95rem; text-align: right; }

  /* — El sello: enlaza al PDF del certificado — */
  .cert {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    max-width: 34rem;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--rule);
    transition: border-color 0.4s ease, background-color 0.4s ease;
  }
  .cert:hover,
  .cert:focus-visible { border-color: var(--accent); }

  .cert__seal {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--accent);
  }
  .cert__seal svg { width: 100%; height: 100%; }

  .cert__text { display: grid; gap: 0.2rem; min-width: 0; }
  .cert__label { color: var(--fg-faint); }
  .cert__name {
    font-size: 0.9rem;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .cert__meta { color: var(--fg-faint); text-transform: none; letter-spacing: 0.04em; }

  .cert__cta { color: var(--fg-muted); white-space: nowrap; }
  .cert__cta span {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cert:hover .cert__cta span { transform: translateX(0.25rem); }

  @media (max-width: 480px) {
    .cert { grid-template-columns: auto minmax(0, 1fr); }
    .cert__cta { display: none; }
  }
</style>
