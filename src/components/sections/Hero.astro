---
import { site, mediaKitPdf } from '~/data/site';
import Horizon from '~/components/Horizon.astro';
import { en } from '~/data/en';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

/*
  La versión en inglés es la página para agencias: su acción principal es el
  formulario de la propia página, y el segundo enlace lleva a la versión en
  español en vez de al PDF (que está en español).
*/
const t =
  lang === 'en'
    ? {
        chapter: 'The start',
        claim: en.claimHtml,
        cta: { label: 'Work with me', href: '#contact' },
        second: { label: 'Versión en español', href: '/', download: false },
        scroll: 'Scroll',
      }
    : {
        chapter: 'La salida',
        claim: 'Running, viajes y la clase de historias que sólo se cuentan <em>después</em> de haberlas caminado.',
        cta: { label: 'Trabajar conmigo', href: '/media-kit' },
        second: { label: mediaKitPdf.label, href: mediaKitPdf.file, download: true },
        scroll: 'Desplázate',
      };
// TEMPORAL: retrato del hero retirado a petición de Diego.
// Para devolverlo: descomenta este import y el bloque .hero__portrait de abajo.
// import DustFrame from '~/components/DustFrame.astro';
// import retrato from '~/assets/media/diego-super8.jpg';
---

<section class="hero" data-tone="night" data-hero data-chapter={t.chapter}>
  <Horizon />

  <!--
    Ficha de cabecera. Va fuera de la rejilla y anclada bajo el menú: dentro
    quedaba centrada con el resto y en portátil se metía detrás de la foto.
  -->
  <div class="hero__meta shell">
    <p class="kicker hero__coords" data-hero-fade>{site.coords}</p>
  </div>

  <div class="hero__grid shell">
    <h1 class="hero__title display t-hero" data-hero-title>
      <span class="hero__line hero__line--a">Diego</span>
      <span class="hero__line hero__line--b">DPL</span>
    </h1>

    <p class="hero__claim" data-hero-fade set:html={t.claim} />

    <!--
      La primera pantalla tenía claim pero ninguna acción: quien llega desde
      la bio de Instagram no tenía dónde pulsar. Estos dos enlaces son la
      entrada comercial; el resto del viaje sigue intacto más abajo.
    -->
    <div class="hero__actions" data-hero-fade>
      <a href={t.cta.href} class="btn" data-magnetic>
        {t.cta.label}
        <span aria-hidden="true">→</span>
      </a>
      <a href={t.second.href} class="hero__pdf" download={t.second.download || undefined}>
        <span class="kicker">{t.second.label}</span>
        <span aria-hidden="true">{t.second.download ? '↓' : '→'}</span>
      </a>
    </div>

    <div class="hero__scroll" data-hero-fade>
      <span class="kicker">{t.scroll}</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </div>
  </div>

  {/* TEMPORAL — retrato retirado. Descomenta para devolverlo.
  <!--
    El retrato: en escritorio es un panel a la derecha, junto al nombre.
    En móvil pasa a ser el fondo a sangre, detrás del texto. Es el mismo
    elemento y la misma foto: sólo cambia el CSS, así se descarga una vez.
    Va fuera de .hero__grid para poder posicionarse respecto a la sección.
  -->
  <div class="hero__portrait" data-parallax="6">
    <DustFrame
      src={retrato}
      alt="Diego DPL grabando con una cámara Super 8 frente a un acantilado"
      format="portrait"
      loading="eager"
      sizes="(min-width: 900px) 30vw, 100vw"
      position="52% 45%"
    />
    <p class="hero__caption kicker">Super 8 · sin retoque</p>
  </div>
  */}

  <div class="hero__veil" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 7rem clamp(1.75rem, 3vw, 3rem);
    overflow: clip;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    align-items: end;
    row-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .hero__pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-muted);
    text-decoration: none;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--rule);
    transition: color 0.4s var(--ease-soft), border-color 0.4s var(--ease-soft);
  }
  .hero__pdf:hover,
  .hero__pdf:focus-visible { color: var(--fg); border-color: var(--accent); }

  .hero__meta {
    position: absolute;
    top: clamp(4.75rem, 4rem + 3vw, 6.5rem);
    left: 0;
    right: 0;
    z-index: 3; /* por encima del retrato */
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 1rem;
  }
  /* Sólo las coordenadas: el rol ya lo dice el menú, justo encima */
  .hero__coords { margin: 0; text-align: right; }

  .hero__title {
    grid-column: 1 / -1;
    margin: 0;
    display: grid;
    /* algo de aire: si no, la 'g' de Diego choca con DPL */
    line-height: 0.94;
    color: var(--color-sand-50);
    will-change: transform, opacity, filter;
  }

  .hero__line {
    display: block;
    /* Cada línea entra sola, desde el polvo */
    opacity: 0;
    transform: translate3d(0, 0.28em, 0);
    filter: blur(18px);
  }
  :global(body.is-ready) .hero__line {
    opacity: 1;
    transform: none;
    filter: blur(0);
    transition:
      opacity 1.6s var(--ease-dust),
      transform 1.9s var(--ease-dust),
      filter 1.6s var(--ease-dust);
  }
  .hero__line--b {
    font-style: italic;
    margin-left: 0.22em;
    color: var(--color-sand-200);
    transition-delay: 0.16s !important;
  }

  .hero__claim {
    grid-column: 1 / -1;
    max-width: 34ch;
    margin: 0;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem);
    line-height: 1.55;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  /* :global() porque el claim entra con set:html y no lleva el atributo de ámbito */
  .hero__claim :global(em) { font-family: var(--font-display); font-size: 1.2em; color: var(--color-ochre); }

  .hero__scroll {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }
  .hero__scroll-line {
    position: relative;
    flex: 1;
    max-width: 9rem;
    height: 1px;
    background: var(--rule);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-ochre);
    transform-origin: left;
    animation: scroll-sweep 2.6s var(--ease-soft) infinite;
  }
  @keyframes scroll-sweep {
    0%   { transform: translateX(-100%); }
    55%  { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  /* ============================================================
     APILADO: retrato (0) → velo (1) → texto (2)
     MÓVIL: el retrato es el fondo, a sangre y atenuado.
     ============================================================ */
  .hero__portrait {
    position: absolute;
    inset: -8% 0;
    z-index: 0;
  }
  .hero__portrait :global(.frame) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    opacity: 0.72;
  }
  .hero__caption { display: none; }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgb(11 9 7 / 0.6) 0%,
        transparent 22%,
        transparent 46%,
        rgb(11 9 7 / 0.55) 60%,
        rgb(11 9 7 / 0.92) 76%
      );
  }

  /* ============================================================
     ESCRITORIO: el retrato pasa a ser un panel junto al nombre.
     La rejilla le reserva su columna, así que nunca pisa el texto.
     ============================================================ */
  @media (min-width: 900px) {
    .hero { align-items: center; padding-block: 6.5rem clamp(1.5rem, 3vw, 2.5rem); }

    /* El nombre no puede depender sólo del ancho: en un portátil con la
       barra del navegador puesta se comía el indicador de scroll. Atado
       también al alto, el hero entra entero en cualquier pantalla. */
    .hero__title { font-size: min(clamp(3.5rem, 1.2rem + 15.5vw, 20rem), 24vh); }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr) clamp(16rem, 27vw, 25rem);
      column-gap: clamp(2rem, 5vw, 5rem);
      /* el hueco entre filas también cede en pantallas bajas */
      row-gap: clamp(0.85rem, 2.4vh, 2.25rem);
    }
    .hero__claim { max-width: 32ch; }
    .hero__scroll { grid-column: 1; max-width: 22rem; }

    .hero__portrait {
      z-index: 2;
      right: clamp(1.25rem, 0.6rem + 3vw, 5rem);
      left: auto;
      width: clamp(16rem, 27vw, 25rem);
      /* Centrado vertical con sesgo hacia arriba. Nada de translate: el
         parallax de GSAP escribe en transform y se pisarían. */
      /* el 'top' hace de suelo: la foto nunca sube hasta la ficha de
         cabecera, ni siquiera en un portátil con la barra del navegador */
      top: clamp(9rem, 14vh, 11rem);
      bottom: clamp(4rem, 14vh, 9rem);
      margin-block: auto;
      height: max-content;
    }
    .hero__portrait :global(.frame) {
      height: auto;
      aspect-ratio: 4 / 5 !important;
      opacity: 1;
    }
    .hero__caption {
      display: block;
      margin: 0.85rem 0 0;
      color: var(--fg-faint);
    }

    /* El velo asienta el menú arriba y oscurece la mitad del texto: el
       resplandor del sol queda libre a la derecha, detrás de nada. */
    .hero__veil {
      background:
        linear-gradient(180deg, rgb(11 9 7 / 0.55) 0%, transparent 22%),
        radial-gradient(70% 80% at 12% 52%, rgb(11 9 7 / 0.7) 0%, rgb(11 9 7 / 0.3) 55%, transparent 80%);
    }
  }

</style>
