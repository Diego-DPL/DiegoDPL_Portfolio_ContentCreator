---
/**
 * EL DESIERTO
 * -----------
 * Un respiro entre el manifiesto y el trabajo. Una sola imagen a sangre y
 * una sola frase: el tramo del camino en el que no hay nadie mirando.
 * La foto va casi entera porque su fuerza está en la escala.
 *
 * Con JavaScript, la sección se queda fija un tramo: la foto se acerca y la
 * frase se enfoca palabra a palabra (main.ts). Es el único sitio de la web
 * que te obliga a quedarte quieto, que es justo lo que se siente ahí.
 */
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const t =
  lang === 'en'
    ? {
        chapter: 'The desert',
        kicker: 'The desert',
        line: ['Out', 'here', 'nobody'],
        lineEm: ['is', 'watching.'],
        after: 'It is the only part that matters.',
        alt: 'Diego DPL, tiny in the middle of the badlands, hands on his knees after a run',
      }
    : {
        chapter: 'El desierto',
        kicker: 'El desierto',
        line: ['Aquí', 'no', 'hay', 'nadie'],
        lineEm: ['que', 'te', 'vea.'],
        after: 'Es la única parte que importa.',
        alt: 'Diego DPL, diminuto en mitad de unos badlands, con las manos en las rodillas después de correr',
      };
const { line, lineEm } = t;
import DustFrame from '~/components/DustFrame.astro';
import elDesierto from '~/assets/media/el-desierto.jpg';
---

<section class="dst" data-tone="night" data-chapter={t.chapter} data-desert>
  <div class="dst__media">
    <DustFrame
      src={elDesierto}
      alt={t.alt}
      format="landscape"
      sizes="100vw"
      widths={[720, 1100, 1500, 1900, 2160]}
      quality={60}
      position="50% 62%"
    />
  </div>

  <!-- La misma brasa del cielo del hero: el sol que se puso sigue aquí -->
  <div class="dst__ember" aria-hidden="true"></div>
  <div class="dst__tint" aria-hidden="true"></div>
  <div class="dst__scrim" aria-hidden="true"></div>

  <div class="dst__text shell">
    <p class="kicker" data-reveal>{t.kicker}</p>
    <p class="dst__line display">
      {line.map((w, i) => <Fragment><span class="dst__w" data-word>{w}</span>{i < line.length - 1 && ' '}</Fragment>)}<br />
      <em>{lineEm.map((w, i) => <Fragment><span class="dst__w" data-word>{w}</span>{i < lineEm.length - 1 && ' '}</Fragment>)}</em>
    </p>
    <p class="dst__after kicker" data-desert-after>{t.after}</p>
  </div>
</section>

<style>
  .dst {
    position: relative;
    /* pantalla entera: mientras está fija, no hay nada más */
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(3rem, 7vw, 6rem);
    overflow: clip;
  }

  .dst__media {
    position: absolute;
    inset: -7% 0;
    z-index: 0;
  }
  .dst__media :global(.frame) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
  }

  .dst__ember {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(90% 60% at 78% 38%, rgb(244 198 133 / 0.7), transparent 70%),
      linear-gradient(180deg, rgb(122 54 34 / 0.8) 0%, rgb(217 121 63 / 0.55) 45%, rgb(122 54 34 / 0.3) 100%);
    mix-blend-mode: soft-light;
  }
  /* soft-light sólo calienta lo que ya tiene color: un cielo gris necesita
     además un velo que lo tiña de tarde */
  .dst__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(201 138 69 / 0.22), rgb(167 95 60 / 0.12) 60%, transparent);
    mix-blend-mode: multiply;
  }

  .dst__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgb(11 9 7 / 0.55) 0%,
        rgb(11 9 7 / 0.05) 22%,
        rgb(11 9 7 / 0.3) 55%,
        rgb(11 9 7 / 0.88) 92%,
        rgb(11 9 7 / 0.96) 100%
      );
  }

  .dst__text {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    gap: 1rem;
    color: var(--color-sand-50);
  }

  .dst__line {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.1rem, 1.2rem + 4.2vw, 5.25rem);
    line-height: 1.02;
    text-wrap: balance;
  }
  .dst__line em { font-style: italic; color: var(--color-ochre); }
  .dst__w { display: inline-block; }
  .dst__after { margin: 0.5rem 0 0; color: var(--color-sand-300); }

  /*
    Móvil: la foto es apaisada y en vertical ocupa todo el alto, así que la
    figura cae en la mitad de abajo y el texto la tapaba. Aquí el texto sube
    al cielo, que es la zona vacía, y la foto se encuadra sobre la figura
    (main.ts además la acerca hacia ella).
  */
  @media (max-width: 899px) {
    .dst {
      align-items: flex-start;
      padding-top: clamp(6.5rem, 16svh, 9rem);
    }
    .dst__media :global(.frame) { --pos: 40% 60% !important; }
    .dst__scrim {
      background: linear-gradient(
        180deg,
        rgb(11 9 7 / 0.8) 0%,
        rgb(11 9 7 / 0.45) 30%,
        rgb(11 9 7 / 0.08) 50%,
        rgb(11 9 7 / 0.1) 72%,
        rgb(11 9 7 / 0.75) 100%
      );
    }
  }

  @media (min-width: 900px) {
    .dst { min-height: 100svh; }
  }
</style>
