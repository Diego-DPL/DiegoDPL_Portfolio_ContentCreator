---
import { site, contact, socials } from '~/data/site';
---

<section class="ct" id="contacto" data-tone="night">
  <div class="shell">
    <header class="ct__head">
      <p class="kicker" data-reveal>06 — Contacto</p>
      <h2 class="ct__title display t-xl" data-reveal style="--rv-delay:.08s">
        Empecemos<br /><em>el camino</em>
      </h2>
      <p class="lede ct__lede" data-reveal style="--rv-delay:.16s">
        Cuéntame qué quieres contar. Leo todo y contesto en menos de 48 horas,
        aunque la respuesta sea que no soy la persona indicada.
      </p>
    </header>

    <div class="ct__grid">
      <form
        class="ct__form"
        data-contact-form
        data-access-key={contact.formAccessKey}
        data-mailto={site.email}
        action={contact.endpoint}
        method="POST"
        novalidate
      >
        {contact.formAccessKey && <input type="hidden" name="access_key" value={contact.formAccessKey} />}
        <input type="hidden" name="from_name" value="Web diegodpl.com" />
        <input
          type="checkbox"
          name="botcheck"
          class="sr-only"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <div class="field" data-reveal>
          <label for="f-name">Cómo te llamas</label>
          <input id="f-name" name="name" type="text" required autocomplete="name" placeholder="Nombre y apellidos" />
        </div>

        <div class="field" data-reveal style="--rv-delay:.06s">
          <label for="f-email">Tu email</label>
          <input id="f-email" name="email" type="email" required autocomplete="email" placeholder="tu@marca.com" />
        </div>

        <div class="field" data-reveal style="--rv-delay:.12s">
          <label for="f-company">Marca o proyecto</label>
          <input id="f-company" name="company" type="text" autocomplete="organization" placeholder="Opcional" />
        </div>

        <div class="field field--half" data-reveal style="--rv-delay:.18s">
          <label for="f-subject">Qué necesitas</label>
          <select id="f-subject" name="subject" required>
            <option value="" disabled selected>Elige una</option>
            {contact.subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div class="field field--half" data-reveal style="--rv-delay:.24s">
          <label for="f-budget">Presupuesto</label>
          <select id="f-budget" name="budget">
            <option value="" disabled selected>Elige uno</option>
            {contact.budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>

        <div class="field" data-reveal style="--rv-delay:.3s">
          <label for="f-message">La idea</label>
          <textarea
            id="f-message"
            name="message"
            rows="5"
            required
            placeholder="Qué quieres contar, para cuándo y dónde va a vivir."></textarea>
        </div>

        <div class="ct__actions" data-reveal style="--rv-delay:.36s">
          <button type="submit" class="btn" data-magnetic>
            Enviar
            <span aria-hidden="true">→</span>
          </button>
          <p class="ct__status kicker" data-form-status role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="ct__aside">
        <div class="ct__block" data-reveal>
          <p class="kicker">Directo</p>
          <a href={`mailto:${site.email}`} class="ct__mail link-dust">{site.email}</a>
        </div>

        <div class="ct__block" data-reveal style="--rv-delay:.1s">
          <p class="kicker">Redes</p>
          <ul class="ct__socials">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="me noopener" class="ct__social">
                    <span class="link-dust">{s.label}</span>
                    <span class="ct__handle kicker">{s.handle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ct__block" data-reveal style="--rv-delay:.2s">
          <p class="kicker">Dónde</p>
          <p class="ct__where">{site.location}</p>
          <p class="ct__where ct__where--faint">
            Disponible para viajar. Cuanto más lejos, mejor.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ct { padding-block: clamp(6rem, 13vw, 13rem); }

  .ct__head { max-width: 44ch; margin-bottom: clamp(3rem, 7vw, 6rem); display: grid; gap: 1.25rem; }
  .ct__title { margin: 0; }
  .ct__title em { font-style: italic; color: var(--color-ochre); }
  .ct__lede { margin: 0; }

  .ct__grid { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 950px) {
    .ct__grid { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: clamp(3rem, 6vw, 6rem); }
  }

  /* — Formulario — */
  .ct__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }
  .field { grid-column: 1 / -1; display: grid; gap: 0.5rem; padding-block: 1.15rem; border-top: 1px solid var(--rule); }
  @media (min-width: 620px) { .field--half { grid-column: span 1; } .field--half + .field--half { padding-left: 1.5rem; border-left: 1px solid var(--rule); } }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.5;
    resize: vertical;
    border-radius: 0;
  }
  .field select { appearance: none; cursor: pointer; }
  .field option { background: var(--color-ink-800); color: var(--color-sand-100); }

  .field input::placeholder,
  .field textarea::placeholder { color: var(--fg-faint); }

  .field:focus-within { border-top-color: var(--color-ochre); }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible { outline: none; }
  .field:focus-within label { color: var(--color-ochre); }

  .field input:user-invalid,
  .field textarea:user-invalid { color: var(--color-clay); }

  .ct__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .ct__status { margin: 0; }
  .ct__status[data-kind='ok'] { color: var(--color-ochre); }
  .ct__status[data-kind='error'] { color: var(--color-clay); }

  /* — Columna lateral — */
  .ct__aside { display: grid; gap: 2.5rem; align-content: start; }
  .ct__block { display: grid; gap: 0.85rem; padding-top: 1.15rem; border-top: 1px solid var(--rule); }
  .ct__mail { justify-self: start; font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem); }

  .ct__socials { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .ct__social { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .ct__handle { color: var(--fg-faint); }

  .ct__where { margin: 0; font-size: 0.95rem; }
  .ct__where--faint { color: var(--fg-muted); }
</style>
