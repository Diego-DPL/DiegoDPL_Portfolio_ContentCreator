---
import { nav, site } from '~/data/site';
import { en } from '~/data/en';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

// El menú de la página en inglés apunta a sus propias secciones; el enlace
// de idioma lleva siempre a la otra versión.
const items = lang === 'en' ? en.nav : nav;
const otro = lang === 'en'
  ? { href: '/', label: 'ES', lang: 'es', title: 'Versión en español' }
  : { href: '/en/', label: 'EN', lang: 'en', title: 'English version' };

const path = Astro.url.pathname;
---

<header class="nav" data-nav>
  <div class="nav__inner shell">
    <a href="/" class="nav__mark" aria-label={`${site.name} — inicio`}>
      <span class="nav__mark-name">Diego DPL</span>
      <span class="nav__mark-role kicker">{lang === 'en' ? en.role : site.role}</span>
    </a>

    <nav class="nav__links" aria-label={lang === 'en' ? 'Main' : 'Principal'}>
      {
        items.map((item) => (
          <a
            href={item.href}
            class="nav__link"
            aria-current={path === item.href ? 'page' : undefined}
          >
            <span class="nav__link-index">{item.index}</span>
            <span class="link-dust">{item.label}</span>
          </a>
        ))
      }
      <a
        href={otro.href}
        class="nav__lang"
        hreflang={otro.lang}
        lang={otro.lang}
        aria-label={otro.title}
      >
        <span class="link-dust">{otro.label}</span>
      </a>
    </nav>

    <button class="nav__burger" data-menu-toggle aria-expanded="false" aria-controls="menu">
      <span class="sr-only">{lang === 'en' ? 'Open menu' : 'Abrir menú'}</span>
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-menu data-tone="night">
  <div class="menu__inner shell">
    <p class="kicker menu__label">{lang === 'en' ? 'Index' : 'Índice'}</p>
    <ul class="menu__list">
      {
        items.map((item) => (
          <li class="menu__item">
            <a href={item.href}>
              <span class="menu__index">{item.index}</span>
              <span class="menu__text display">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="menu__foot kicker">
      {site.coords} · {site.location}
      <a href={otro.href} class="menu__lang link-dust" hreflang={otro.lang} lang={otro.lang}>
        {otro.lang === 'en' ? 'English' : 'Español'}
      </a>
    </p>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding-block: clamp(1rem, 0.7rem + 0.9vw, 1.75rem);
    transition:
      transform 0.7s var(--ease-dust),
      background-color 0.6s linear,
      backdrop-filter 0.6s linear;
    mix-blend-mode: difference;
    color: var(--color-sand-50);
  }
  .nav.is-hidden { transform: translate3d(0, -110%, 0); }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__mark { display: grid; gap: 0.25rem; line-height: 1; }
  .nav__mark-name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .nav__mark-role { color: color-mix(in oklab, currentColor 55%, transparent); }

  .nav__links {
    display: none;
    align-items: baseline;
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }
  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .nav__link-index {
    font-size: 0.6rem;
    opacity: 0.45;
  }
  .nav__link[aria-current='page'] { color: var(--color-ochre); }

  .nav__lang {
    margin-left: 0.5rem;
    padding-left: clamp(1.25rem, 2.4vw, 2.5rem);
    border-left: 1px solid color-mix(in oklab, currentColor 30%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .nav__burger {
    display: grid;
    gap: 5px;
    padding: 0.6rem 0;
    width: 30px;
  }
  .nav__burger-line {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease-dust);
  }
  .nav__burger-line:last-child { width: 62%; margin-left: auto; }

  @media (min-width: 1000px) {
    .nav__links { display: flex; }
    .nav__burger { display: none; }
  }

  /* — Menú a pantalla completa — */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: grid;
    align-items: center;
    background: var(--color-ink-900);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s var(--ease-dust);
    pointer-events: none;
  }
  .menu.is-open {
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
  }

  .menu__label { margin-bottom: 2.5rem; }

  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.25rem, 1vw, 0.75rem);
  }
  .menu__item a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 0.35rem;
    opacity: 0;
    transform: translate3d(0, 1.2rem, 0);
    transition: opacity 0.7s var(--ease-dust), transform 0.7s var(--ease-dust);
  }
  .menu.is-open .menu__item a { opacity: 1; transform: none; }
  .menu__item:nth-child(1) a { transition-delay: 0.14s; }
  .menu__item:nth-child(2) a { transition-delay: 0.2s; }
  .menu__item:nth-child(3) a { transition-delay: 0.26s; }
  .menu__item:nth-child(4) a { transition-delay: 0.32s; }
  .menu__item:nth-child(5) a { transition-delay: 0.38s; }
  .menu__item:nth-child(6) a { transition-delay: 0.44s; }

  .menu__index {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--fg-faint);
  }
  .menu__text {
    font-size: clamp(2.5rem, 1.4rem + 8vw, 5rem);
    transition: color 0.4s var(--ease-soft);
  }
  .menu__item a:hover .menu__text { color: var(--color-ochre); font-style: italic; }

  .menu__foot { margin-top: 3.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .menu__lang { color: var(--color-ochre); }

  :global(html.is-menu-open) { overflow: hidden; }
</style>
