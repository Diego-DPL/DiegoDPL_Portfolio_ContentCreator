---
import '~/styles/global.css';
import { site, socials, certification } from '~/data/site';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import Journey from '~/components/Journey.astro';

interface Props {
  title?: string;
  description?: string;
  /** Oculta el preloader en páginas interiores */
  preload?: boolean;
  /** Datos estructurados extra de esta página (Article, migas, etc.) */
  schema?: Record<string, unknown>[];
  /** Imagen al compartir. Ruta en /public o imagen importada. */
  image?: string | { src: string };
  /** Idioma de la página */
  lang?: 'es' | 'en';
  /** Versiones en otros idiomas de ESTA página, para hreflang */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description = site.description,
  preload = true,
  schema = [],
  image = '/og.jpg',
  lang = 'es',
  alternates = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(typeof image === 'string' ? image : image.src, Astro.site ?? site.url).href;

/**
 * Un solo grafo para toda la página: quién soy, qué es este sitio y lo que
 * cada página añada por su cuenta (un artículo, unas migas de pan…).
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#diego`,
      name: site.name,
      url: site.url,
      email: `mailto:${site.email}`,
      jobTitle: site.role,
      description: site.description,
      address: { '@type': 'PostalAddress', addressLocality: 'Murcia', addressCountry: 'ES' },
      knowsLanguage: [...site.languages],
      knowsAbout: [
        'Creación de contenido para marcas',
        'Running y trail running',
        'Fotografía documental',
        'Producción y edición de vídeo',
        'Normativa publicitaria para influencers',
      ],
      sameAs: socials.map((s) => s.href),
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: certification.name,
        credentialCategory: 'certificate',
        recognizedBy: {
          '@type': 'Organization',
          name: certification.issuerFull,
          url: certification.issuerUrl,
        },
        dateCreated: certification.issued,
        expires: certification.expires,
        url: `${site.url}${certification.file}`,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#web`,
      url: site.url,
      name: site.name,
      inLanguage: lang === 'en' ? 'en-GB' : 'es-ES',
      publisher: { '@id': `${site.url}/#diego` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={lang} class:list={[preload && 'is-loading']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      site.googleVerification && (
        <meta name="google-site-verification" content={site.googleVerification} />
      )
    }

    <meta name="theme-color" content="#0B0907" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Diario — ${site.name}`}
      href="/rss.xml"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Sin JavaScript la web se lee entera: nada de quedarse tras el preloader */}
    <noscript>
      <style>
        #preloader { display: none !important; }
        html.is-loading { overflow: auto !important; }
      </style>
    </noscript>

    {/* Seguro de última instancia por si el bundle nunca llega a ejecutarse */}
    <script is:inline>
      setTimeout(function () {
        var el = document.getElementById('preloader');
        if (el && !el.classList.contains('is-done')) {
          el.classList.add('is-done');
          document.documentElement.classList.remove('is-loading');
        }
      }, 6000);
    </script>
  </head>

  <body>
    {
      preload && (
        <div id="preloader">
          <div class="preloader__inner">
            <p class="kicker preloader__word">Diego DPL</p>
            <p class="preloader__num display" data-preload-num>
              000
            </p>
            <p class="kicker preloader__hint">El camino empieza solo</p>
          </div>
        </div>
      )
    }

    <div class="vignette" aria-hidden="true"></div>
    <canvas id="dust-canvas" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <div class="cursor" aria-hidden="true">
      <div class="cursor__ring"></div>
      <div class="cursor__dot"></div>
    </div>

    <a href="#main" class="skip">Saltar al contenido</a>

    <Nav lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <Journey lang={lang} />

    <script>
      import '~/scripts/main';
    </script>

    <style is:global>
      .skip {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 200;
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        background: var(--color-sand-50);
        color: var(--color-ink-900);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transform: translateY(-160%);
        transition: transform 0.4s var(--ease-dust);
      }
      .skip:focus-visible { transform: none; }

      .preloader__inner {
        display: grid;
        justify-items: center;
        gap: 1.25rem;
        text-align: center;
      }
      .preloader__num {
        margin: 0;
        font-size: clamp(4rem, 12vw, 9rem);
        color: var(--color-sand-100);
        font-variant-numeric: tabular-nums;
      }
      .preloader__word,
      .preloader__hint { margin: 0; }
      .preloader__hint { color: var(--color-sand-400); }
    </style>
  </body>
</html>
