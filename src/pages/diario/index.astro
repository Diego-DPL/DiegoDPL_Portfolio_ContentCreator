---
import Base from '~/layouts/Base.astro';
import DustFrame from '~/components/DustFrame.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Base
  title="Diario"
  description="Notas del camino: textos sobre entrenamiento, viajes, oficio y la parte del trabajo que nadie ve."
  preload={false}
>
  <section class="dr-hero" data-tone="night">
    <div class="shell">
      <p class="kicker" data-reveal>05 — Diario</p>
      <h1 class="dr-hero__title display t-xl" data-reveal style="--rv-delay:.08s">
        Notas del<br /><em>camino</em>
      </h1>
      <p class="lede dr-hero__lede" data-reveal style="--rv-delay:.16s">
        Lo que no cabe en un vídeo de treinta segundos. Entrenamiento, viajes,
        oficio y la parte aburrida —que es casi toda.
      </p>
    </div>
  </section>

  <section class="dr-list" data-tone="day">
    <div class="shell">
      <ul class="dr-grid">
        {
          posts.map((post, i) => (
            <li class="dr-card" data-reveal style={`--rv-delay:${(i % 3) * 90}ms`}>
              <a href={`/diario/${post.id}/`} class="dr-card__link">
                <DustFrame
                  src={post.data.cover}
                  alt={post.data.title}
                  format="landscape"
                  label={post.data.place ?? 'Diario'}
                  seed={i + 5}
                />
                <div class="dr-card__body">
                  <p class="kicker dr-card__meta">
                    {fmt(post.data.date)}
                    {post.data.place && <span> · {post.data.place}</span>}
                  </p>
                  <h2 class="dr-card__title display">{post.data.title}</h2>
                  <p class="dr-card__excerpt">{post.data.excerpt}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .dr-hero {
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    padding-block: 9rem clamp(3rem, 7vw, 6rem);
  }
  .dr-hero__title { margin: 1rem 0 1.5rem; }
  .dr-hero__title em { font-style: italic; color: var(--color-ochre); }
  .dr-hero__lede { max-width: 44ch; margin: 0; }

  .dr-list { padding-block: clamp(4rem, 9vw, 9rem); }
  .dr-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 720px) { .dr-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1180px) { .dr-grid { grid-template-columns: repeat(3, 1fr); } }

  .dr-card__link { display: grid; gap: 1.25rem; }
  .dr-card :global(.frame) { transition: filter 0.8s var(--ease-dust); }
  .dr-card__link:hover :global(.frame) { filter: brightness(1.08); }

  .dr-card__body { display: grid; gap: 0.5rem; }
  .dr-card__meta { color: var(--fg-faint); }
  .dr-card__title {
    margin: 0;
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.9rem);
    line-height: 1.1;
    text-wrap: balance;
    transition: color 0.45s var(--ease-soft);
  }
  .dr-card__link:hover .dr-card__title { color: var(--accent); font-style: italic; }
  .dr-card__excerpt { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--fg-muted); text-wrap: pretty; }
</style>
